# Copy to .env and fill in. Never commit .env.
AGENT_LIVE_CALLS_ENABLED=false
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30

AGENT_LIVE_MARKET_DATA=false

# --- SnapTrade Sandbox (development-only, READ-ONLY). Disabled by default. ---
# Real values belong in a server-side secret store, never in Git or Android.
SNAPTRADE_ENABLED=false
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_ENVIRONMENT=sandbox
SNAPTRADE_REDIRECT_URI=easymoney://portfolio/snaptrade
SNAPTRADE_CONNECTION_TYPE=read
SNAPTRADE_BROKER=SANDBOX
SNAPTRADE_TIMEOUT_SECONDS=20
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SNAPTRADE_ENCRYPTION_KEY=
