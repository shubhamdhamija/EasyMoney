{
  "name": "easymoney-ai-server",
  "version": "0.1.0",
  "description": "Backend services for EasyMoney: event processor, RAG, embeddings, vector store",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --test",
    "eval:fake": "AI_EVAL_MODE=fake node evals/runStockExplanationEvals.js",
    "eval:live": "AI_EVAL_MODE=live node evals/runStockExplanationEvals.js",
    "eval:insight:fake": "AI_EVAL_MODE=fake node evals/runStockInsightEvals.js",
    "eval:insight:live": "AI_EVAL_MODE=live node evals/runStockInsightEvals.js",
    "eval:picks:fake": "AI_EVAL_MODE=fake node evals/runStockPicksEvals.js",
    "eval:picks:live": "AI_EVAL_MODE=live node evals/runStockPicksEvals.js"
  },
  "dependencies": {
    "@pinecone-database/pinecone": "^3.0.0",
    "axios": "^1.5.0",
    "body-parser": "^1.20.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^11.9.0",
    "node-cron": "^3.0.2",
    "pg": "^8.11.0",
    "uuid": "^9.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
