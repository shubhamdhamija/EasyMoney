# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: openai | pollinations | openai_compat
LLM_PROVIDER=pollinations
LLM_MODEL=gpt-4o-mini

# OpenAI (optional) - used for embeddings + LLM if OPENAI_API_KEY is set
OPENAI_API_KEY=
OPENAI_URL=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=text-embedding-3-small

# ── Vector Store ───────────────────────────────────────────────────────────────
# Pinecone (optional) - leave blank to use local_vectors fallback
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
VECTOR_INDEX=stock-index

# ── Market Data APIs ───────────────────────────────────────────────────────────
# Finnhub - used for stock quotes, earnings, and company data
# Get a free key at https://finnhub.io
FINNHUB_API_KEY=

# Polygon.io - used for gainers/losers snapshot (optional, falls back to Finnhub)
# Get a free key at https://polygon.io
POLYGON_API_KEY=

# Comma-separated list of symbols to scan for gainers/losers when using Finnhub
# Leave blank to use the built-in default universe
MOVERS_UNIVERSE=

# ── Watchlist ──────────────────────────────────────────────────────────────────
# Sample watchlist used when no DB user is found
SAMPLE_WATCHLIST=AAPL,NVDA,TSLA,MSFT,AMZN

# ── Firebase Push Notifications ───────────────────────────────────────────────
# Path to Firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080

